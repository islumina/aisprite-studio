{
  "name": "aisprite-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "mcp-server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "aibridgejs": "0.6.0",
    "aieventjs": "0.6.0",
    "aifsmjs": "0.6.0",
    "aipooljs": "0.6.0",
    "aispritejs": "0.6.0"
  },
  "scripts": {
    "plan": "node mcp-server/dist/plan.js",
    "serve": "node server.mjs",
    "test": "npm run test:server && npm run test:webeditor && npm run test:mcp && npm run test:python && npm run test:parity",
    "test:mcp": "npm --prefix mcp-server run check",
    "test:parity": "node --test tests/spec-parity.test.mjs",
    "test:python": "python3 -m unittest discover -s tests",
    "test:server": "node --test tests/server.test.mjs",
    "test:webeditor": "node --test tests/webeditor.test.mjs",
    "vendor:check": "node tools/vendor-update.mjs --check",
    "vendor:update": "node tools/vendor-update.mjs"
  }
}
