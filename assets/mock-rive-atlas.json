{
  "meta": {
    "image": "reimu_sheet.webp",
    "size": { "w": 2048, "h": 2048 },
    "scale": "1"
  },
  "assetType": "character",
  "inputs": {
    "speed": {
      "type": "number",
      "default": 0
    },
    "isGrounded": {
      "type": "boolean",
      "default": true
    },
    "attackTrigger": {
      "type": "trigger"
    }
  },
  "states": {
    "idle": { "animation": "idle", "loop": true },
    "walk": { "animation": "walk", "loop": true },
    "run": { "animation": "run", "loop": true },
    "jump": { "animation": "jump", "loop": false, "onEnd": "idle" },
    "attack": { "animation": "attack", "loop": false, "onEnd": "idle" }
  },
  "transitions": [
    {
      "from": "*",
      "to": "attack",
      "priority": 2,
      "when": [
        { "input": "attackTrigger", "op": "Trigger" }
      ]
    },
    {
      "from": "*",
      "to": "jump",
      "priority": 1,
      "when": [
        { "input": "isGrounded", "op": "Equals", "value": false }
      ]
    },
    {
      "from": "*",
      "to": "run",
      "priority": 0,
      "when": [
        { "input": "speed", "op": "GreaterThan", "value": 5 },
        { "input": "isGrounded", "op": "Equals", "value": true }
      ]
    },
    {
      "from": "*",
      "to": "walk",
      "priority": 0,
      "when": [
        { "input": "speed", "op": "GreaterThan", "value": 0 },
        { "input": "speed", "op": "LessThan", "value": 5 },
        { "input": "isGrounded", "op": "Equals", "value": true }
      ]
    },
    {
      "from": "*",
      "to": "idle",
      "priority": 0,
      "when": [
        { "input": "speed", "op": "Equals", "value": 0 },
        { "input": "isGrounded", "op": "Equals", "value": true }
      ]
    }
  ],
  "initial": "idle",
  "animations": {
    "idle": ["idle_00", "idle_01"],
    "walk": ["walk_00", "walk_01"],
    "run": ["run_00", "run_01"],
    "jump": ["jump_00"],
    "attack": ["attack_00", "attack_01"]
  },
  "frames": {
    "idle_00": {
